# Copy to .env and fill in.
# Adzuna: https://developer.adzuna.com/  (free account)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Reed: https://www.reed.co.uk/developers  (free API key)
REED_API_KEY=

DATABASE_URL=sqlite:///ghostjobs.db
DEFAULT_KEYWORDS=junior developer
DEFAULT_LOCATION=Corby

# Searches for the scheduled run, separated by ";"
SEARCHES=junior developer;IT support;graduate software;data analyst

# Phone notifications - install the ntfy app, subscribe to this topic.
# Topic names are public on ntfy.sh, so make it long and random.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
NOTIFY_MAX_SCORE=30
NOTIFY_REQUIRE_SALARY=false
NOTIFY_MAX_PER_RUN=5

# Search radius around DEFAULT_LOCATION
SEARCH_RADIUS_MILES=20
# Adverts not seen for this many days count as taken down
STALE_AFTER_DAYS=3
