# Copy to .env and fill in.

# Job boards to use, comma-separated: reed / adzuna / reed,adzuna
SOURCES=reed

# Reed: https://www.reed.co.uk/developers/jobseeker  (free API key, emailed to you)
REED_API_KEY=

# Adzuna: https://developer.adzuna.com/  - free account only gets 25 test calls;
# full access (5,000 calls/month) is a paid plan. Add "adzuna" to SOURCES to use it.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

DATABASE_URL=sqlite:///ghostjobs.db
DEFAULT_KEYWORDS=junior developer
DEFAULT_LOCATION=Corby

# Searches for the scheduled run, separated by ";"
SEARCHES=junior developer;IT support;graduate software;data analyst

# Phone notifications - install the ntfy app, subscribe to this topic.
# Topic names are public on ntfy.sh, so make it long and random.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
# Phone commands: a SECOND random topic. Subscribe to it in the app and send "help".
NTFY_COMMAND_TOPIC=
COMMAND_COOLDOWN_MINUTES=30
NOTIFY_MAX_SCORE=30
NOTIFY_REQUIRE_SALARY=false
# Alerts per run sent individually; the rest come as one summary. 0 = every job individually.
NOTIFY_MAX_PER_RUN=5
# Pause between alerts in seconds (ntfy.sh limits bursts)
NOTIFY_DELAY_SECONDS=1
# Alert order: distance, score, salary, newest, title, company (comma = tie-break)
NOTIFY_SORT=distance,score

# Search radius around DEFAULT_LOCATION
SEARCH_RADIUS_MILES=20
# Result pages per search (100 jobs each on Reed). Use 3 for a 50+ mile radius.
PAGES=1
# Adverts not seen for this many days count as taken down
STALE_AFTER_DAYS=3
