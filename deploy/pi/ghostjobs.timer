[Unit]
Description=Run Ghost Job Tracker once a day in the evening

[Timer]
# Once a day at 18:00: alerts are waiting after work, and Reed calls stay low.
# Change the time here (24h), then: sudo systemctl daemon-reload && sudo systemctl restart ghostjobs.timer
OnCalendar=*-*-* 18:00:00
RandomizedDelaySec=10m
# If the Pi was off at the scheduled time, run once when it boots.
Persistent=true

[Install]
WantedBy=timers.target
